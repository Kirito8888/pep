# ─────────────────────────────────────────────────────────────────────────────
# AthlosPro — variables de entorno
# Copia este archivo a ".env" y ajusta los valores. El archivo ".env" NO se sube
# a GitHub (está en .gitignore).
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (lo usa el servicio "db" de docker-compose) ───────────────────
POSTGRES_USER=athlos
# Cambia esta contraseña antes de exponer la aplicación fuera de tu equipo.
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=athlospro

# ── Aplicación ───────────────────────────────────────────────────────────────
# Puerto del equipo anfitrión en el que se publica la web (http://localhost:3000).
APP_PORT=3000

# Secreto con el que Auth.js firma las sesiones. OBLIGATORIO cambiarlo.
# Genera uno aleatorio:
#   Linux / macOS:        openssl rand -base64 32
#   Windows (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_SECRET=genera_un_secreto_aleatorio_de_32_bytes

# Carga los 2 usuarios de demostración al arrancar ("true" o "false").
SEED_DEMO_DATA=true

# ── Solo para desarrollo SIN Docker (npm run dev) ────────────────────────────
# Con Docker no hace falta: docker-compose construye DATABASE_URL a partir de
# las variables POSTGRES_* de arriba apuntando al servicio "db".
DATABASE_URL=postgresql://athlos:cambia_esta_contrasena@localhost:5432/athlospro?schema=public
AUTH_TRUST_HOST=true
